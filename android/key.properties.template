# انسخ هذا القالب إلى android/key.properties للاستخدام المحلي فقط.
# لا تضع قيماً حقيقية في Git؛ android/key.properties والمخزن مستثنيان من Git.
# للتحديث: أعد استخدام مخزن الإصدار السابق واسم alias وكلمات المرور نفسها؛ لا تنشئ مفتاحاً جديداً.
# اكتب القيم بصيغة Java Properties (اهرب \ و = و : و # و ! والمسافات البادئة).
storePassword=REPLACE_WITH_STORE_PASSWORD
keyPassword=REPLACE_WITH_KEY_PASSWORD
keyAlias=REPLACE_WITH_EXISTING_ALIAS
storeFile=../multazim-keystore.jks

