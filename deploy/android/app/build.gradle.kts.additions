// ═════════════════════════════════════════════════════════════════
//  أضف/عدّل في android/app/build.gradle.kts الناتج من `flutter create`
// ═════════════════════════════════════════════════════════════════
//
//  ⟨تلقائي⟩ على Codemagic (codemagic.yaml) لا تحتاج فعل شيء:
//  السكربت deploy/android/apply_android_gradle.py يضيف desugaring تلقائياً
//  ويصلح استيراد Properties/FileInputStream بعد `flutter create .`.
//
//  ⟨يدوي⟩ إن كنت تبني على جهازك فطبّق التعديلات أدناه.
//  ملاحظة: قالب Flutter الحديث لم يعد يستخدم kotlin-android ولا kotlinOptions؛
//  يضبط Kotlin عبر بلوك `kotlin { compilerOptions { … } }`.
//
//  هذا الملف مرجع للتوثيق فقط — النسخة الحيّة هي android/app/build.gradle.kts.

// ── ٠) إلزامي: استيراد الأصناف في أعلى الملف (قبل بلوك plugins) ─────────
// داخل سكربت تطبيق أندرويد الاسم `java` محجوز لـ«extension» إضافة جافا
// (JavaPluginExtension) وليس للحزمة `java`. لذلك:
//     val keystoreProperties = java.util.Properties()   ✗ يفشل
// ويعطي ثلاثة أخطاء ترجمة للسكربت:
//     Unresolved reference: util
//     Unresolved reference: io
//     Expression expected, but a package name found   ← على سطر storeFile
// الحل: استيراد صريح ثم استخدام الاسم المختصر.
// (في android/settings.gradle.kts لا توجد إضافة جافا، لذا java.util.Properties()
//  تعمل هناك كما في قالب Flutter الرسمي — لا تغيّرها.)
import java.io.FileInputStream
import java.util.Properties

// ── ١) إلزامي: Core Library Desugaring ───────────────────────────
// flutter_local_notifications ‎(10+)‎ يحتاج java.time على أندرويد الأقدم.
// بدون هذا السطر يتوقف البناء برسالة:
//   Dependency ':flutter_local_notifications' requires core library
//   desugaring to be enabled for :app.
android {
    compileOptions {
        isCoreLibraryDesugaringEnabled = true
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
    }
}

dependencies {
    coreLibraryDesugaring("com.android.tools:desugar_jdk_libs:2.1.4")
}

// ── ٢) مفتاح التوقيع (اختياري — للتوزيع على Google Play) ─────────
// اتركه كما هو إن لم يكن لديك android/key.properties: البناء يستخدم
// توقيع debug تلقائياً كما في قالب Flutter، وهذا يكفي للاستخدام الشخصي.
val keystoreProperties = Properties()
val keystorePropertiesFile = rootProject.file("key.properties")
if (keystorePropertiesFile.exists()) {
    keystoreProperties.load(FileInputStream(keystorePropertiesFile))
}

// مسار المخزن نسبيّاً إلى android/app/ (مثال: ../multazim-keystore.jks).
// نتحقّق من وجود الملف فعلاً حتى لا يفشل البناء برسالة توقيع غامضة.
val keystorePath: String = keystoreProperties.getProperty("storeFile")?.trim().orEmpty()
val keystoreFile = if (keystorePath.isEmpty()) {
    null
} else {
    file(keystorePath).takeIf { candidate -> candidate.isFile }
}

if (keystorePropertiesFile.exists() && keystoreFile == null) {
    logger.warn(
        "مُلتزم: android/key.properties موجود لكن تعذّر العثور على مخزن المفاتيح " +
            "«$keystorePath» ⇒ سيُستخدم توقيع debug بدلاً من release."
    )
}

android {
    namespace = "com.multazim.app"
    compileSdk = flutter.compileSdkVersion
    ndkVersion = flutter.ndkVersion

    defaultConfig {
        applicationId = "com.multazim.app"
        minSdk = 24   // ‎24+‎ — يكفي كل حزم المشروع
        targetSdk = flutter.targetSdkVersion
        versionCode = flutter.versionCode
        versionName = flutter.versionName
    }

    signingConfigs {
        create("release") {
            // getProperty تعيد String? مباشرةً — لا حاجة لأي `as String` ولا لـ `it`.
            keyAlias = keystoreProperties.getProperty("keyAlias")
            keyPassword = keystoreProperties.getProperty("keyPassword")
            storeFile = keystoreFile
            storePassword = keystoreProperties.getProperty("storePassword")
        }
    }

    buildTypes {
        release {
            signingConfig = if (keystoreFile != null) {
                signingConfigs.getByName("release")
            } else {
                signingConfigs.getByName("debug")
            }

            // ‎R8‎ مطفأ افتراضياً: الحزم (notifications/audio) تعمل بلا قواعد إضافية،
            // وشغّله فقط بعد اختبار نسخة release على جهاز حقيقي.
            // isMinifyEnabled = true
            // isShrinkResources = true
            // proguardFiles(
            //     getDefaultProguardFile("proguard-android-optimize.txt"),
            //     "proguard-rules.pro",
            // )
        }
    }
}
